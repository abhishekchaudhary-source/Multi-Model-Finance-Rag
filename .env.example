# ==========================================
# 1. VECTOR DATABASE (QDRANT CLOUD)
# ==========================================
QDRANT_URL="https://your-cluster-id.region.aws.cloud.qdrant.io"
QDRANT_API_KEY="your-qdrant-api-key"
QDRANT_COLLECTION="Fintech Collection"

# ==========================================
# 2. RELATIONAL DATABASE (POSTGRESQL)
# ==========================================
DATABASE_URL="postgresql://postgres:password@localhost:5432/finance_rag"

# ==========================================
# 3. EMBEDDING & RE-RANKER (HUGGING FACE)
# ==========================================
EMBEDDING_MODEL="BAAI/bge-small-en-v1.5"
RERANKER_MODEL="BAAI/bge-reranker-v2-m3"
HF_TOKEN="your-huggingface-token"

# ==========================================
# 4. LLM GENERATION MODEL (GEMINI)
# ==========================================
LLM_MODEL="gemini-3.6-flash"
GEMINI_API_URL="https://generativelanguage.googleapis.com"
GEMINI_API_KEY="your-gemini-api-key"

# ==========================================
# 5. RETRIEVAL PARAMETERS (TOP-K)
# ==========================================
DENSE_TOP_K=12
SPARSE_TOP_K=12
HYBRID_TOP_K=12
RERANK_TOP_K=3

# ==========================================
# 6. DOCUMENT CHUNKING PARAMETERS
# ==========================================
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
